SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Direct Python development server origin:
SIMPLECATER_ORIGIN=http://127.0.0.1:8001
# Default Compose deployment origin (separate from host development):
SIMPLECATER_DEPLOY_ORIGIN=http://127.0.0.1:8000
# Direct Python access; Compose overrides this with http://granite:8080/v1.
# Mac demos tunneling local 8081 to LinuxONE 8080 should use port 8081 here.
SIMPLECATER_LLM_URL=http://127.0.0.1:8080/v1
SIMPLECATER_LLM_MODEL=granite
SIMPLECATER_LLM_TIMEOUT_SECONDS=180
SIMPLECATER_LLM_REASONING_FORMAT=none
